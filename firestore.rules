rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user whose UID has a document in /admins.
    // Create those documents by hand in the Firebase Console (Firestore → admins → doc id = user UID).
    // A plain "request.auth != null" check is NOT enough: with email/password sign-in enabled,
    // anyone can create an account using the public API key.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A store (branch counter) account: a signed-in user whose UID has a document in /stores
    // with the branch it redeems at: stores/{uid} = { branchId: 'banawe', name: '...' }.
    // Created by hand in the Firebase Console. Stores can only look up and redeem vouchers (store.html).
    function isStore() {
      return request.auth != null
        && exists(/databases/$(database)/documents/stores/$(request.auth.uid));
    }

    function storeBranch() {
      return get(/databases/$(database)/documents/stores/$(request.auth.uid)).data.branchId;
    }

    function optionalString(d, field, maxLen) {
      return !(field in d) || (d[field] is string && d[field].size() <= maxLen);
    }

    // Shape of a customer survey submission (also used by "Add review" on the dashboard)
    function validSubmission(d) {
      return d.keys().hasOnly(['branchId', 'branchName', 'customerName', 'comment', 'ratings',
                               'atmosphereOpen', 'answers', 'staffMember', 'managerVisit',
                               'dish', 'source', 'survey', 'createdAt'])
        && d.keys().hasAll(['branchId', 'ratings', 'createdAt'])
        && d.branchId is string && d.branchId.size() > 0 && d.branchId.size() <= 50
        && d.ratings is map
        && d.ratings.overall is int && d.ratings.overall >= 1 && d.ratings.overall <= 5
        && optionalString(d, 'branchName', 100)
        && optionalString(d, 'customerName', 100)
        && optionalString(d, 'comment', 2000)
        && optionalString(d, 'staffMember', 100)
        && optionalString(d, 'managerVisit', 200)
        && optionalString(d, 'dish', 200)
        && (!('answers' in d) || d.answers is map)
        && (!('atmosphereOpen' in d) || d.atmosphereOpen is map)
        && (!('source' in d) || isAdmin())   // only staff can record manual reviews
        && (!('survey' in d) || d.survey in ['dinein', 'delivery'])   // which survey it came from
        && d.createdAt == request.time;
    }

    function validBranch(d) {
      return d.keys().hasOnly(['name', 'region', 'address', 'manager', 'googleReviewUrl', 'status', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && optionalString(d, 'region', 100)
        && optionalString(d, 'address', 200)
        && optionalString(d, 'manager', 100)
        // Google review link shown on the public survey: empty, or an https:// link
        && optionalString(d, 'googleReviewUrl', 500)
        && (!('googleReviewUrl' in d) || d.googleReviewUrl == '' || d.googleReviewUrl.matches('^https://[^ ]+$'))
        && d.status in ['active', 'inactive'];
    }

    // Staff profile. The photo must be one of OUR Cloudinary images (it's shown on the public survey).
    function validEmployee(d) {
      return d.keys().hasOnly(['name', 'position', 'branchId', 'photoUrl', 'photoPublicId', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && optionalString(d, 'position', 100)
        && d.branchId is string && d.branchId.size() <= 50
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 500
            && d.photoUrl.matches('^https://res[.]cloudinary[.]com/macowfsm/image/upload/.*')))
        && optionalString(d, 'photoPublicId', 300);
    }

    // ============================================
    // BRANCHES - restaurant locations (doc id = slug referenced by surveys/employees)
    // ============================================
    match /branches/{branchId} {
      allow read: if true;   // the public survey lists active branches
      allow create, update: if isAdmin() && validBranch(request.resource.data)
                            && branchId.size() <= 50;
      allow delete: if false; // deactivate instead: old reviews reference the id
    }

    // ============================================
    // ADMINS - allow-list of dashboard users (managed in the console only)
    // ============================================
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ============================================
    // STORES - branch counter accounts for the redeem kiosk (managed in the console only)
    // ============================================
    // Created by the store itself from an admin's invite link (store.html?invite=...), in ONE batch
    // together with marking the invite 'active' — so each invite works once. Admins revoke by deleting.
    match /stores/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['branchId', 'name', 'email', 'inviteId', 'createdAt'])
        && request.resource.data.inviteId is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && usableInvite(request.resource.data.inviteId, request.resource.data.branchId)
        && getAfter(/databases/$(database)/documents/storeInvites/$(request.resource.data.inviteId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/storeInvites/$(request.resource.data.inviteId)).data.uid == uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ============================================
    // STORE INVITES - "Account Creation" on the dashboard. Doc id = the random token in the
    // emailed link (the secret, like a password-reset link), so anyone holding the link can read it.
    // ============================================
    function usableInvite(inviteId, branchId) {
      let inv = get(/databases/$(database)/documents/storeInvites/$(inviteId)).data;
      return inv.status == 'invited'
        && inv.expiresAt > request.time
        && inv.email == request.auth.token.email
        && inv.branchId == branchId;
    }

    function validInvite(d) {
      return d.keys().hasOnly(['email', 'branchId', 'branchName', 'status', 'expiresAt', 'createdAt',
                               'sentAt', 'uid', 'usedAt', 'revokedAt'])
        && d.email is string && d.email.size() <= 254
        && d.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && d.branchId is string && d.branchId.size() > 0 && d.branchId.size() <= 50
        && optionalString(d, 'branchName', 100)
        && d.status in ['invited', 'active', 'revoked']
        && d.expiresAt is timestamp;
    }

    match /storeInvites/{token} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && token.size() >= 24 && validInvite(request.resource.data);
      // The invited store accepts it once (same batch as creating stores/{uid})
      allow update: if request.auth != null
        && resource.data.status == 'invited'
        && resource.data.expiresAt > request.time
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid', 'usedAt'])
        && request.resource.data.status == 'active'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usedAt == request.time;
    }

    // ============================================
    // SURVEYS - customer survey submissions
    // ============================================
    match /surveys/{docId} {
      allow create: if validSubmission(request.resource.data);  // public: customers have no account
      allow read: if isAdmin();                                  // customer data is private
      // Staff may only resolve (with an internal note), flag, or keep an older reply note;
      // the customer's answers never change
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt', 'flagged',
             'resolved', 'resolutionNote', 'resolvedAt', 'resolvedBy'])
        && optionalString(request.resource.data, 'reply', 1000)
        && optionalString(request.resource.data, 'resolutionNote', 1000)
        && (!('flagged' in request.resource.data) || request.resource.data.flagged is bool)
        && (!('resolved' in request.resource.data) || request.resource.data.resolved is bool)
        && (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy is string);
      allow delete: if false;
    }

    // Voucher offer settings (surveyConfig/voucher, edited on the dashboard's Vouchers page).
    // Until an admin saves them, the defaults below apply (keep in sync with js/voucherConfig.js).
    function voucherCfg() {
      return exists(/databases/$(database)/documents/surveyConfig/voucher)
        ? get(/databases/$(database)/documents/surveyConfig/voucher).data
        : {'enabled': true, 'discountPercent': 15, 'appliesTo': 'Ala Carte Items', 'minSpend': 1000,
           'validityValue': 1, 'validityUnit': 'months'};
    }

    function validVoucherConfig(d) {
      return d.keys().hasOnly(['enabled', 'discountPercent', 'appliesTo', 'minSpend',
                               'validityValue', 'validityUnit', 'conditions', 'updatedAt'])
        && d.enabled is bool
        && d.discountPercent is int && d.discountPercent >= 1 && d.discountPercent <= 100
        && d.appliesTo is string && d.appliesTo.size() > 0 && d.appliesTo.size() <= 60
        && d.minSpend is int && d.minSpend >= 0 && d.minSpend <= 1000000
        && d.validityValue is int && d.validityValue >= 1 && d.validityValue <= 365
        && d.validityUnit in ['days', 'weeks', 'months']
        // Conditions shown in the voucher email / redeem page (text only, 1-10 lines)
        && (!('conditions' in d) || (d.conditions is list
              && d.conditions.size() >= 1 && d.conditions.size() <= 10));
    }

    // Longest allowed validity in days (a little slack for month lengths, time zones and the whole last day)
    function voucherMaxDays(cfg) {
      return cfg.validityUnit == 'months' ? cfg.validityValue * 32
           : cfg.validityUnit == 'weeks' ? cfg.validityValue * 7 + 2
           : cfg.validityValue + 2;
    }

    // A new voucher must carry exactly the current offer
    function matchesVoucherOffer(d, cfg) {
      return cfg.enabled == true
        && d.discountPercent == cfg.discountPercent
        && d.appliesTo == cfg.appliesTo
        && d.minSpend == cfg.minSpend
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(voucherMaxDays(cfg), 'd');
    }

    // ============================================
    // VOUCHERS - voucher emailed after the survey (no customer login)
    // The deal (discount, applies to, min spend, expiry) is copied into each voucher from
    // surveyConfig/voucher, so changing the settings never changes vouchers already sent.
    // Doc id = the customer's lowercased email. Rules only allow *creating* a new doc,
    // so a second voucher for the same email is a write to an existing doc → rejected.
    // Each voucher must point at a real survey submitted in the last 15 minutes.
    // Staff confirm ownership at the counter by asking to see the voucher email.
    // ============================================
    match /vouchers/{emailId} {
      // Stores: one voucher at a time (by email = doc id, or by code with limit(1)),
      // plus the vouchers redeemed at their own branch ("Today's redemptions"). No bulk listing.
      allow get: if isAdmin() || isStore();
      allow list: if isAdmin()
        || (isStore() && (request.query.limit <= 1
                          || resource.data.redeemedBranchId == storeBranch()));
      allow create: if request.resource.data.keys().hasOnly(['code', 'email', 'surveyId', 'branchId',
                                                             'discountPercent', 'appliesTo', 'minSpend',
                                                             'expiresAt', 'status', 'createdAt'])
        && request.resource.data.email == emailId
        && emailId.size() <= 254
        && emailId.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')   // lowercase, email-shaped
        && request.resource.data.code is string && request.resource.data.code.size() == 8
        && matchesVoucherOffer(request.resource.data, voucherCfg())
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.branchId is string && request.resource.data.branchId.size() <= 50
        && request.resource.data.surveyId is string
        && exists(/databases/$(database)/documents/surveys/$(request.resource.data.surveyId))
        && get(/databases/$(database)/documents/surveys/$(request.resource.data.surveyId)).data.createdAt
             > request.time - duration.value(15, 'm');
      // Staff redeem once, before the voucher's expiry; the customer can never change it.
      // Admins redeem at any branch; a store account only at its own branch.
      // Older vouchers have no expiresAt: they were valid for 1 calendar month (32 days covers it).
      allow update: if (isAdmin()
            || (isStore() && request.resource.data.redeemedBranchId == storeBranch()))
        && resource.data.status == 'active'
        && (('expiresAt' in resource.data)
              ? request.time <= resource.data.expiresAt
              : request.time < resource.data.createdAt + duration.value(32, 'd'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'redeemedAt', 'redeemedBy', 'redeemedBranchId'])
        && request.resource.data.status == 'redeemed'
        && request.resource.data.redeemedAt == request.time
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.redeemedBranchId is string;
      allow delete: if false;
    }

    // ============================================
    // SURVEY CONFIG - star-rating categories ("Please rate the following items"):
    //                 'ratingCategories' (dine-in) and 'deliveryRatingCategories' (delivery),
    //                 and the voucher offer settings (doc 'voucher')
    // ============================================
    match /surveyConfig/{docId} {
      allow read: if true;   // the public survey reads the categories and the voucher offer
      allow write: if isAdmin() && (
        (docId in ['ratingCategories', 'deliveryRatingCategories']
          && request.resource.data.keys().hasOnly(['title', 'categories', 'updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.categories is list
          && request.resource.data.categories.size() >= 1
          && request.resource.data.categories.size() <= 10)
        || (docId == 'voucher' && validVoucherConfig(request.resource.data)));
    }

    // ============================================
    // SURVEY QUESTIONS - read by the public survey page
    // ============================================
    match /surveyQuestions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // EMPLOYEES - names are shown in the public survey's staff picker
    // ============================================
    match /employees/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validEmployee(request.resource.data);
      allow delete: if isAdmin();
    }

    // Default deny 
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
